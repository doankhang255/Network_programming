@startuml 04_game_room_state
!include ../../style.iuml
hide empty description
title Game room state machine (one per match, many in parallel)

state "<b>FINISHED</b>" as FINISHED
state "<b>CLOSED</b>" as CLOSED

[*] --> WHITE_TURN : server creates room\n(match found / invite accepted)\ncolours chosen at random

state "<b>PLAYING</b>" as PLAYING {
  state "<b>WHITE_TURN</b>" as WHITE_TURN : accepts MOVE from white\nillegal move -> MOVE_REJECTED
  state "<b>BLACK_TURN</b>" as BLACK_TURN : accepts MOVE from black\nillegal move -> MOVE_REJECTED
  WHITE_TURN --> BLACK_TURN : white\nmoves
  BLACK_TURN --> WHITE_TURN : black\nmoves
}

PLAYING --> FINISHED : checkmate · stalemate (draw)\ndraw agreed · resign / leave\nconnection lost
FINISHED --> CLOSED : GAME_OVER sent to both,\nElo updated (ranked only),\ngame saved
CLOSED --> [*] : players go back\nto their own rooms

note right of PLAYING
  OFFER_DRAW / ACCEPT_DRAW / DECLINE_DRAW
  and RESIGN are accepted in both turns.
  Every message to this room is handled
  under the room's own lock.
end note
@enduml
