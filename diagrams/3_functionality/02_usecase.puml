@startuml 02_usecase
!include ../style.iuml
' Wide layout (about 2.3 : 1) so it fills the content area of the 16:9 slide.
top to bottom direction
skinparam dpi 200
skinparam packageStyle rectangle
skinparam nodesep 14
skinparam ranksep 12
skinparam usecase {
  FontSize 16
}
skinparam package {
  FontSize 17
}
skinparam rectangle {
  FontSize 17
}
skinparam actor {
  FontSize 16
}
skinparam ArrowFontSize 14
skinparam NoteFontSize 14

actor Player

rectangle "Online Chess Application" {
  package "Account" as ACC {
    usecase "UC1 Register" as UC1
    usecase "UC2 Log in" as UC2
    usecase "UC3 Log out" as UC3
  }
  package "Online & friends" as ONL {
    usecase "UC4 Online players\n(all + friends)" as UC4
    usecase "UC5 Add friend" as UC5
  }
  package "Rooms & matchmaking" as ROOMS {
    usecase "UC6 My room\n(created at login)" as UC6
    usecase "UC7 Random match\n(unrated)" as UC7
    usecase "UC8 Ranked match\n(rated)" as UC8
    usecase "UC9 Cancel search" as UC9
    usecase "UC10 Invite friend\n(unrated)" as UC10
    usecase "UC11 Answer invite" as UC11
    note "Timer on the server:\ninvitations expire after 30 s;\nranked rating range widens every 10 s" as NTIMER
  }
  package "Game (in a server game room)" as GAME {
    usecase "UC12 Move\n(server validates)" as UC12
    usecase "UC13 Draw offer" as UC13
    usecase "UC14 Resign / leave" as UC14
    usecase "UC15 End game" as UC15
    usecase "UC16 Update rating" as UC16
    usecase "UC17 Leaderboard" as UC17
  }
}

' The player uses every use case of a group: one association per group keeps the picture readable.
Player --> ACC
Player --> ONL
Player --> ROOMS
Player --> GAME

' Stack the use cases of each group in columns (layout only).
UC1 -[hidden]down- UC2
UC2 -[hidden]down- UC3
UC4 -[hidden]down- UC5
UC6 -[hidden]down- UC7
UC7 -[hidden]down- UC8
UC9 -[hidden]down- UC10
UC10 -[hidden]down- UC11
UC6 -[hidden]right- UC9
UC8 -[hidden]down- NTIMER
UC12 -[hidden]down- UC13
UC13 -[hidden]down- UC14
UC14 -[hidden]down- UC17

' Relations between use cases
UC15 .right.> UC13 : <<extend>>
UC15 .[norank].> UC12 : <<extend>>
UC14 .[norank].> UC15 : <<include>>
UC16 .up.> UC15 : <<extend>>\n(ranked only)
@enduml
