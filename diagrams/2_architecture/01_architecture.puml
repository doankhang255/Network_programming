@startuml
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam shadowing false
skinparam ArrowColor #1F3A5F
skinparam ArrowFontSize 12
skinparam RectangleBackgroundColor #F1F5FA
skinparam RectangleBorderColor #1F3A5F
skinparam DatabaseBackgroundColor #E6F4EE
skinparam DatabaseBorderColor #0F6E56
skinparam FileBackgroundColor #F5F5F0
skinparam PackageBorderColor #1F3A5F
skinparam roundcorner 12
title Online Chess - Client/Server architecture over TCP

rectangle "<b>Player A</b>\nClient app (Java Swing)" as A
rectangle "<b>Player B</b>\nClient app (Java Swing)" as B

package "Game server (Java)" {
  rectangle "<b>Network layer</b>\naccept new connections\n1 reader thread per player\nsend replies to players" as NET
  rectangle "<b>Lobby</b> (1 thread)\nregister · login\nonline count · friends online\nrandom queue · ranked queue\nfriend invites (30 s)\nElo rating (ranked only) · leaderboard" as LOBBY
  rectangle "<b>Game rooms</b> (1 thread per game)\nRoom 1 · Room 2 · ... · Room N\nmoves · draw offer · resign\ndisconnect = lose" as ROOM
  rectangle "<b>Chess rules library</b>\nlegal move? checkmate? stalemate?" as RULES
}
file "<b>server.log</b>\nevery message in/out" as LOG
database "<b>Database</b>\nusers (password, rating)\nfriends" as DB

A --> NET : TCP
B --> NET : TCP
NET -right-> LOG : log
NET --> LOBBY : player not in a game
NET --> ROOM : player in a game
LOBBY -right-> ROOM : (1) match found:\nopen a new room
ROOM -left-> LOBBY : (2) game over:\nsend result, close room
ROOM --> RULES : check each move
LOBBY --> DB : accounts · friends\n(3) save new rating
@enduml
