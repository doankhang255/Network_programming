@startuml 05_seq_ranked_match
!include ../../style.iuml
autonumber
title Sequence – Ranked match: find opponent, server creates game room

participant "Client A\n (1500)" as A
box "Server" #fbfcfe
  participant "Matchmaking\n(ranked queue)" as MM
  participant "Game room manager" as GRM
end box
participant "Client B\n (1650)" as B

A -> MM : FIND_MATCH|RANKED
MM -> MM : khang: IDLE -> SEARCHING\nrange ±100
MM --> A : SEARCHING|RANKED
B -> MM : FIND_MATCH|RANKED
MM -> MM : minh: IDLE -> SEARCHING\nrange ±100
MM --> B : SEARCHING|RANKED

loop every 1 s until a pair is found
  MM -> MM : for each waiting player:\nrange = 100 + 100 × (seconds waited / 10)
  MM -> MM : |1500 − 1650| = 150\n0–9 s: 150 > 100, keep waiting\n10 s: 150 ≤ 200, match!
end

MM -> GRM : createGameRoom(khang, minh, RANKED)
GRM -> GRM : game room 12 = PLAYING\ncolours at random: khang WHITE
GRM --> A : MATCH_FOUND|12|WHITE|minh|1650
GRM --> B : MATCH_FOUND|12|BLACK|khang|1500

note over A, B
  Before a match is found, CANCEL_MATCH removes the player
  from the queue (SEARCHING -> IDLE).
  FIND_MATCH|RANDOM works the same way without the rating range
  (first come, first matched) and the game is unrated.
end note
@enduml
