' Shared look for all diagrams (HUST navy / red)
skinparam dpi 150
skinparam defaultFontName "Helvetica Neue"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor white
skinparam ArrowColor #0b3a6e
skinparam ArrowFontSize 11
skinparam ArrowFontColor #1f2933
skinparam NoteBackgroundColor #fff7f8
skinparam NoteBorderColor #b5223a
skinparam NoteFontSize 11

skinparam state {
  BackgroundColor #f2f5f9
  BorderColor #0b3a6e
  FontColor #0b3a6e
  FontStyle bold
  AttributeFontSize 11
  AttributeFontColor #1f2933
  StartColor #0b3a6e
  EndColor #0b3a6e
}

skinparam sequence {
  ParticipantBackgroundColor #f2f5f9
  ParticipantBorderColor #0b3a6e
  ParticipantFontColor #0b3a6e
  ActorBackgroundColor #f2f5f9
  ActorBorderColor #0b3a6e
  LifeLineBorderColor #8899aa
  LifeLineBackgroundColor #dfe7f1
  GroupBorderColor #b5223a
  GroupHeaderFontColor #b5223a
  DividerBackgroundColor #f2f5f9
  DividerBorderColor #0b3a6e
}
skinparam DatabaseBackgroundColor #f2f5f9
skinparam DatabaseBorderColor #0b3a6e

skinparam component {
  BackgroundColor #f2f5f9
  BorderColor #0b3a6e
  FontColor #0b3a6e
}
skinparam node {
  BackgroundColor white
  BorderColor #8899aa
}
skinparam package {
  BackgroundColor #fbfcfe
  BorderColor #0b3a6e
  FontColor #0b3a6e
}
skinparam queue {
  BackgroundColor #fff7f8
  BorderColor #b5223a
}

skinparam usecase {
  BackgroundColor #f2f5f9
  BorderColor #0b3a6e
  FontColor #0b3a6e
}
skinparam actor {
  BackgroundColor #f2f5f9
  BorderColor #0b3a6e
}
skinparam rectangle {
  BorderColor #0b3a6e
  FontColor #0b3a6e
}
skinparam class {
  BackgroundColor #f2f5f9
  BorderColor #0b3a6e
  HeaderBackgroundColor #dfe7f1
  FontColor #0b3a6e
  FontStyle bold
  AttributeFontColor #1f2933
}
