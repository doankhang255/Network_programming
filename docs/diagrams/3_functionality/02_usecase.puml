@startuml 02_usecase
!include ../style.iuml
left to right direction
title Online Chess – Use cases (UC1–UC17)

actor Player
actor Timer as T

rectangle "Online Chess Application" {
  package "Account" {
    usecase "UC1 Register" as UC1
    usecase "UC2 Log in" as UC2
    usecase "UC3 Log out" as UC3
  }
  package "Online & friends" {
    usecase "UC4 View online players\n(all + friends)" as UC4
    usecase "UC5 Add friend" as UC5
  }
  package "Rooms & matchmaking" {
    usecase "UC6 My room\n(created at login)" as UC6
    usecase "UC7 Random match\n(unrated)" as UC7
    usecase "UC8 Ranked match\n(rated)" as UC8
    usecase "UC9 Cancel search" as UC9
    usecase "UC10 Invite friend\n(unrated)" as UC10
    usecase "UC11 Accept / decline\ninvitation" as UC11
  }
  package "Game (in a server game room)" {
    usecase "UC12 Move\n(server validates)" as UC12
    usecase "UC13 Offer / answer draw" as UC13
    usecase "UC14 Resign / leave game" as UC14
    usecase "UC15 End game,\nannounce result" as UC15
    usecase "UC16 Update rating\n(ranked only)" as UC16
  }
  usecase "UC17 View leaderboard" as UC17
}

Player --> UC1
Player --> UC2
Player --> UC3
Player --> UC4
Player --> UC5
Player --> UC6
Player --> UC7
Player --> UC8
Player --> UC9
Player --> UC10
Player --> UC11
Player --> UC12
Player --> UC13
Player --> UC14
Player --> UC17

UC12 <.. UC15 : <<extend>>\n[checkmate / stalemate]
UC13 <.. UC15 : <<extend>>\n[draw accepted]
UC14 ..> UC15 : <<include>>
UC15 <.. UC16 : <<extend>>\n[ranked game]

UC11 <-- T : expire after 30 s
UC8 <-- T : widen rating\nrange every 10 s
@enduml
